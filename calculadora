<?php

$number_1;
$number_2;

function calculadora($opcao, $number_1, $number_2){
   
     if($opcao == "+"){
            $resultado = $number_1 + $number_2;
            echo "$resultado\n";
     }else if($opcao == "-"){
            $resultado = $number_1 - $number_2;
            echo "$resultado\n";
     }else if($opcao == "*"){
            $resultado = $number_1 * $number_2;
            echo "$resultado\n";
     }else if($opcao == "/"){
            $resultado = $number_1 / $number_2;
            echo "$resultado\n";
     }else{
            echo "ERRO\n";
     }
}
calculadora("*", 912, 16);
calculadora("/", 14545, 5);
?>
